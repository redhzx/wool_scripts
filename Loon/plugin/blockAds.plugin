[Rewrite]
# >>>>>>>>>>>>>>> ✅ 0 ✅ <<<<<<<<<<<<<<



# > 阿里巴巴
# hostname = acs.m.taobao.com, heic.alicdn.com, guide-acs.m.taobao.com, poplayer.template.alibaba.com
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome/i then reject_dict(200)
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources/i then reject_dict(200)
request if ${url} ~= /^https:\/\/heic\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(octopus|tps-1125-1602|tps-1080-1920)\.(jp|pn)g_(1\d{3}|9\d{2})x(1\d{3}|9\d{2})q[59]0/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad/i then reject_dict(200)
request if ${url} ~= /^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get)/i then reject_dict(200)

# > 阿里云盘
# hostname = api.alipan.com, member.alipan.com
request if ${url} ~= /^https:\/\/api\.alipan\.com\/adrive\/v1\/file\/getTopFolders/i then reject_dict(200)
request if ${url} ~= /^https:\/\/member\.alipan\.com\/v2\/activity\/sign_in_luckyBottle/i then reject_dict(200)

# > 爱回收
# hostname = gw.aihuishou.com
request if ${url} ~= /^https?:\/\/gw\.aihuishou\.com\/app-portal\/home\/getadvertisement/i then reject(404)


# > 爱奇艺
# hostname = -i.vip.iqiyi.com, *.iqiyi.com
# 播放页开通会员提示
request if ${url} ~= /^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api\/v2\/show\?/i then reject_dict(200)
# 播放页多余动效
request if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\?/i then reject_dict(200)
# 播放页升级白金会员按钮
request if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\?/i then reject_dict(200)
# 青少年弹窗
request if ${url} ~= /^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\?/i then reject_dict(200)

# > 爱企查
# hostname = b2baifanfan.baidu.com
request if ${url} ~= /^https?:\/\/b2baifanfan\.baidu\.com\/crm\/web\/b2b\/im\/common\/getConfigByDeviceNum/i then reject(200)


# > 爱思助手
# hostname = list-app-m.i4.cn
request if ${url} ~= /^https?:\/\/list-app-m\.i4\.cn\/(adclickcb|getHotSearchList|getopfstadinfo)\.xhtml/i then reject(404)


# > Amazon
# hostname = api-cslp-emt.amazon.cn
request if ${url} ~= /^https?:\/\/api-cslp-emt\.amazon\.cn\/gateway\/content\/widget\/popup/i then reject(200)
request if ${url} ~= /^https?:\/\/api-cslp-emt\.amazon\.cn\/gateway\/recommend/i then reject_dict(200)


# >>>>>>>>>>>>>>> ✅ B ✅ <<<<<<<<<<<<<<

# > 百度
# hostname = www.baidu.com, fcvbjbcebos.baidu.com, cover.baidu.com, baichuan.baidu.com, api*.tuisong.baidu.com, afd.baidu.com, mobads.baidu.com, issuecdn.baidupcs.com, update.pan.baidu.com, sa*.tuisong.baidu.com, m.baidu.com, sofire.baidu.com
request if ${url} ~= /^https?:\/\/fcvbjbcebos\.baidu\.com\/.+.mp4/i then reject(404)
request if ${url} ~= /^https?:\/\/fcvbjbcebos\.baidu\.com\/.+?\.mp4/i then reject_img(200)
request if ${url} ~= /^https?:\/\/cover\.baidu\.com\/cover\/page\/dspSwitchAds\//i then reject(404)
request if ${url} ~= /^https?:\/\/baichuan\.baidu\.com\/rs\/adpmobile\/launch/i then reject(404)
request if ${url} ~= /^https?:\/\/api\d\.tuisong\.baidu\.com/i then reject_img(200)
request if ${url} ~= /^https?:\/\/afd\.baidu\.com\/afd\/entry/i then reject(404)
request if ${url} ~= /^https?:\/\/als\.baidu\.com\/clog\/clog/i then reject(404)
request if ${url} ~= /^https?:\/\/mobads\.baidu\.com\/cpro\/ui\/mads.+/i then reject(404)
request if ${url} ~= /^https?:\/\/issuecdn\.baidupcs\.com\/issue\/netdisk\/guanggao\//i then reject(200)
request if ${url} ~= /^https?:\/\/[\s\S]*\.baidu\.com\/.*?ad[xs]\.php/i then reject_img(200)
request if ${url} ~= /^https?:\/\/t\d{2}\.baidu\.com/i then reject_img(200)
request if ${url} ~= /^https?:\/\/log.+?baidu\.com/i then reject(404)
request if ${url} ~= /^https?:\/\/sa\d\.tuisong\.baidu\.com/i then reject_img(200)
